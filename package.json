{
  "name": "gssk-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first energy-systems diagram editor and simulator (Odum Energy Systems Language), running the pinned GSSK kernel in the browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "bundle-size": "node scripts/bundle-size.ts",
    "gssk:verify": "node scripts/gssk-verify.ts",
    "gssk:update": "sh scripts/gssk-update.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "5.0.3"
  }
}
